import { createFileRoute } from "@tanstack/react-router";
import { useEffect, useMemo, useRef, useState } from "react";
import { createPortal } from "react-dom";
import {
  Trophy,
  Award,
  Eye,
  Flame,
  Shield,
  Heart,
  Crown,
  Lock,
  CheckCircle,
  Target,
  Sparkles,
  X,
  type LucideIcon,
} from "lucide-react";
import { AppShell } from "@/components/prono/AppShell";
import { fetchUserTrophies } from "@/lib/supabase-service";
import { supabase } from "@/lib/supabase";

export const Route = createFileRoute("/trophees")({
  head: () => ({
    meta: [
      { title: "Votre palmares - Prono Ligue 1" },
      {
        name: "description",
        content: "Ton Hall of Fame personnel : trophees debloques, progression et prochain objectif.",
      },
    ],
  }),
  component: TropheesPage,
});

type TrophyCategory = "Debutant" | "Regularite" | "Precision" | "Passion" | "Performance";

type TrophyDef = {
  id: string;
  name: string;
  desc: string;
  goal: number;
  category: TrophyCategory;
  icon: LucideIcon;
};

const ALL_TROPHIES: TrophyDef[] = [
  { id: "t1", name: "Premier prono", desc: "Valider ton premier pronostic", goal: 1, category: "Debutant", icon: Award },
  { id: "t2", name: "Oeil de lynx", desc: "Trouver 5 scores exacts", goal: 5, category: "Precision", icon: Eye },
  { id: "t3", name: "Serie parfaite", desc: "3 journees consecutives au-dessus de 30 pts", goal: 3, category: "Regularite", icon: Flame },
  { id: "t4", name: "Fidele", desc: "Pronostiquer 10 journees d'affilee", goal: 10, category: "Regularite", icon: Shield },
  { id: "t5", name: "Supporter", desc: "Choisir ton club de coeur", goal: 1, category: "Passion", icon: Heart },
  { id: "t6", name: "Roi de la journee", desc: "Finir 1er d'une journee", goal: 1, category: "Performance", icon: Crown },
];

type UserTrophyRow = {
  trophy_id: string;
  progress: number | null;
  unlocked: boolean | null;
  updated_at: string | null;
};

type TrophyState = "locked" | "in_progress" | "unlocked";

type TrophyView = TrophyDef & {
  progressRaw: number;
  unlocked: boolean;
  ratio: number;
  state: TrophyState;
  updatedAt: string | null;
};

const STATE_META: Record<TrophyState, { label: string; badgeClass: string; cardClass: string; iconWrapClass: string; barClass: string }> = {
  locked: {
    label: "Verrouille",
    badgeClass: "border-slate-700 bg-slate-800/60 text-slate-500",
    cardClass: "border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1]",
    iconWrapClass: "border-slate-700/60 bg-slate-800/40 text-slate-600",
    barClass: "bg-slate-600",
  },
  in_progress: {
    label: "En progression",
    badgeClass: "border-emerald-400/30 bg-emerald-400/10 text-emerald-300",
    cardClass: "border-emerald-400/[0.16] bg-emerald-400/[0.035] hover:border-emerald-400/30",
    iconWrapClass: "border-emerald-400/30 bg-emerald-400/10 text-emerald-300",
    barClass: "bg-emerald-400",
  },
  unlocked: {
    label: "Debloque",
    badgeClass: "border-amber-300/35 bg-amber-300/10 text-amber-200",
    cardClass: "border-amber-300/[0.2] bg-emerald-400/[0.05] shadow-[0_0_30px_rgba(16,185,129,.1)] hover:border-amber-300/40",
    iconWrapClass: "border-amber-300/40 bg-gradient-to-br from-amber-300/25 to-emerald-400/15 text-amber-200",
    barClass: "bg-gradient-to-r from-emerald-400 to-amber-300",
  },
};

function formatObtainedDate(iso: string): string | null {
  try {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return null;
    return new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" }).format(d);
  } catch {
    return null;
  }
}

function ProgressBar({ ratio, state }: { ratio: number; state: TrophyState }) {
  const pct = Math.round(Math.min(Math.max(ratio, 0), 1) * 100);
  return (
    <div className="h-1.5 w-full overflow-hidden rounded-full bg-white/[0.07]">
      <div className={`h-full rounded-full transition-all duration-700 ease-out ${STATE_META[state].barClass}`} style={{ width: `${pct}%` }} />
    </div>
  );
}

function TrophyMedal({ view, size = 46 }: { view: TrophyView; size?: number }) {
  const Icon = view.icon;
  const meta = STATE_META[view.state];
  return (
    <div className="relative shrink-0" style={{ width: size, height: size }}>
      {view.state !== "locked" && (
        <div className={`absolute inset-0 rounded-2xl blur-lg ${view.state === "unlocked" ? "bg-amber-300/25" : "bg-emerald-400/20"}`} aria-hidden="true" />
      )}
      <div className={`relative flex h-full w-full items-center justify-center rounded-2xl border ${meta.iconWrapClass}`}>
        <Icon size={Math.round(size * 0.46)} strokeWidth={1.7} />
      </div>
      {view.state === "locked" && (
        <div className="absolute -bottom-1.5 -right-1.5 flex size-5 items-center justify-center rounded-full border border-slate-700 bg-[#0b111c] text-slate-500">
          <Lock size={11} strokeWidth={2} />
        </div>
      )}
    </div>
  );
}

function HeroStat({ label, value }: { label: string; value: string | number }) {
  return (
    <div className="rounded-xl border border-white/10 bg-white/[0.04] px-3 py-2.5 text-center backdrop-blur-sm">
      <div className="font-display text-lg font-black text-white sm:text-xl">{value}</div>
      <div className="mt-0.5 font-mono text-[8px] font-semibold uppercase tracking-widest text-slate-500">{label}</div>
    </div>
  );
}

function TrophyCard({ view, index, isNew, onOpen }: { view: TrophyView; index: number; isNew: boolean; onOpen: () => void }) {
  const meta = STATE_META[view.state];
  return (
    <button type="button" onClick={onOpen} aria-label={`Voir le detail du trophee ${view.name} - statut : ${meta.label}`}
      className={`troph-fade-up group relative flex h-full flex-col overflow-hidden rounded-2xl border p-5 text-left backdrop-blur-md transition-all duration-300 hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400/60 ${meta.cardClass} ${isNew ? "troph-new-glow" : ""}`}
      style={{ animationDelay: `${Math.min(index, 8) * 60}ms` }}>
      <div className="flex items-start justify-between">
        <TrophyMedal view={view} size={46} />
        <span className="font-mono text-[10px] text-slate-600">{String(index + 1).padStart(2, "0")}</span>
      </div>
      <div className="mt-4">
        <div className="font-display text-base font-bold text-white">{view.name}</div>
        <div className="font-mono text-[9px] font-semibold uppercase tracking-[.18em] text-slate-500">{view.category}</div>
      </div>
      <p className="mt-2 text-xs leading-relaxed text-slate-400">{view.desc}</p>
      <div className="mt-auto pt-4">
        <div className="flex items-center justify-between text-[11px] font-bold text-white"><span>{view.progressRaw} / {view.goal}</span></div>
        <div className="mt-1.5"><ProgressBar ratio={view.ratio} state={view.state} /></div>
        <div className={`mt-3 inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[9px] font-bold uppercase tracking-widest ${meta.badgeClass}`}>
          {view.state === "unlocked" && <CheckCircle size={11} />}
          {view.state === "locked" && <Lock size={11} />}
          {meta.label}
        </div>
      </div>
    </button>
  );
}

function TrophyModal({ view, onClose }: { view: TrophyView; onClose: () => void }) {
  const meta = STATE_META[view.state];
  const remaining = Math.max(view.goal - view.progressRaw, 0);
  const obtainedDate = view.unlocked && view.updatedAt ? formatObtainedDate(view.updatedAt) : null;

  useEffect(() => {
    function onKey(e: KeyboardEvent) { if (e.key === "Escape") onClose(); }
    document.addEventListener("keydown", onKey);
    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    return () => { document.removeEventListener("keydown", onKey); document.body.style.overflow = previousOverflow; };
  }, [onClose]);

  return createPortal(
    <div className="fixed inset-0 z-[100] flex items-end justify-center bg-black/70 backdrop-blur-sm sm:items-center sm:p-4" role="presentation" onClick={onClose}>
      <div role="dialog" aria-modal="true" aria-labelledby="trophy-modal-title" onClick={(e) => e.stopPropagation()}
        className="troph-modal-in relative w-full max-w-sm rounded-t-[26px] border border-white/10 bg-[#0a1220]/95 p-6 shadow-[0_-20px_60px_rgba(0,0,0,.5)] backdrop-blur-xl sm:rounded-[26px] sm:shadow-[0_30px_80px_rgba(0,0,0,.5)]">
        <button type="button" onClick={onClose} aria-label="Fermer la fenetre de detail"
          className="absolute right-4 top-4 grid size-8 place-items-center rounded-full border border-white/10 bg-white/[0.05] text-slate-400 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400/60">
          <X size={15} />
        </button>
        <div className="flex flex-col items-center pt-2 text-center">
          <TrophyMedal view={view} size={64} />
          <h3 id="trophy-modal-title" className="mt-4 font-display text-xl font-bold uppercase text-white">{view.name}</h3>
          <div className="mt-1 font-mono text-[10px] font-semibold uppercase tracking-[.2em] text-slate-500">{view.category}</div>
          <p className="mt-3 text-sm text-slate-400">{view.desc}</p>
          <div className="mt-6 w-full text-left">
            <div className="font-mono text-[9px] font-semibold uppercase tracking-widest text-slate-500">Progression</div>
            <div className="mt-1 flex items-center justify-between text-sm font-bold text-white"><span>{view.progressRaw} / {view.goal}</span><span className="text-emerald-300">{Math.round(view.ratio * 100)}%</span></div>
            <div className="mt-1.5"><ProgressBar ratio={view.ratio} state={view.state} /></div>
            {!view.unlocked && <p className="mt-2 text-xs text-emerald-300">Encore {remaining} pour debloquer ce trophee</p>}
          </div>
          <div className={`mt-5 inline-flex items-center gap-2 rounded-full border px-4 py-2 font-mono text-[10px] font-bold uppercase tracking-widest ${meta.badgeClass}`}>
            {view.unlocked ? <CheckCircle size={13} /> : view.state === "locked" ? <Lock size={13} /> : null}
            {view.unlocked ? "Trophee debloque" : meta.label}
          </div>
          {obtainedDate && <div className="mt-3 text-[11px] text-slate-500">Debloque le {obtainedDate}</div>}
        </div>
      </div>
    </div>,
    document.body
  );
}

function TropheesPage() {
  const [userTrophies, setUserTrophies] = useState<UserTrophyRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [connected, setConnected] = useState(true);
  const [errorMessage, setErrorMessage] = useState("");
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [newlyUnlockedIds, setNewlyUnlockedIds] = useState<Set<string>>(new Set());
  const hasCheckedNewUnlocks = useRef(false);

  useEffect(() => {
    async function loadData() {
      setLoading(true);
      setErrorMessage("");
      try {
        const { data: { user }, error: authError } = await supabase.auth.getUser();
        if (authError) throw authError;
        if (!user) { setConnected(false); setUserTrophies([]); setLoading(false); return; }
        setConnected(true);
        const data = await fetchUserTrophies(user.id);
        setUserTrophies((data || []) as UserTrophyRow[]);

        if (!hasCheckedNewUnlocks.current) {
          hasCheckedNewUnlocks.current = true;
          try {
            const key = `troph_seen_${user.id}`;
            const stored = localStorage.getItem(key);
            const previouslySeen: string[] = stored ? JSON.parse(stored) : [];
            const currentUnlocked = (data || []).filter((row: UserTrophyRow) => row.unlocked).map((row: UserTrophyRow) => row.trophy_id);
            const fresh = currentUnlocked.filter((id: string) => !previouslySeen.includes(id));
            if (fresh.length) setNewlyUnlockedIds(new Set(fresh));
            localStorage.setItem(key, JSON.stringify(currentUnlocked));
          } catch {}
        }
      } catch (err) {
        console.error("Erreur chargement trophees:", err);
        setErrorMessage("Impossible de charger ton palmares pour le moment.");
      } finally {
        setLoading(false);
      }
    }
    loadData();
  }, []);

  const views = useMemo<TrophyView[]>(() => ALL_TROPHIES.map((trophy) => {
    const row = userTrophies.find((t) => t.trophy_id === trophy.id);
    const unlocked = Boolean(row?.unlocked);
    const progressRaw = Math.max(0, Number(row?.progress ?? 0));
    const ratio = trophy.goal > 0 ? Math.min(progressRaw / trophy.goal, 1) : 0;
    const state: TrophyState = unlocked ? "unlocked" : progressRaw > 0 ? "in_progress" : "locked";
    return { ...trophy, progressRaw, unlocked, ratio, state, updatedAt: row?.unlocked ? row?.updated_at ?? null : null };
  }), [userTrophies]);

  const unlockedCount = views.filter((v) => v.unlocked).length;
  const inProgressCount = views.filter((v) => !v.unlocked && v.progressRaw > 0).length;
  const totalCount = ALL_TROPHIES.length;
  const progressionPct = totalCount ? Math.round((unlockedCount / totalCount) * 100) : 0;

  const nextObjective = useMemo(() => {
    const locked = views.filter((v) => !v.unlocked);
    if (!locked.length) return null;
    return locked.reduce((best, v) => (v.ratio > best.ratio ? v : best), locked[0]);
  }, [views]);

  const selectedView = selectedId ? views.find((v) => v.id === selectedId) ?? null : null;

  return (
    <AppShell>
      <style>{`
        @keyframes troph-fade-up { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes troph-glow-pulse { 0% { box-shadow: 0 0 0px rgba(251,191,36,0); } 35% { box-shadow: 0 0 42px rgba(251,191,36,.4); } 100% { box-shadow: 0 0 22px rgba(16,185,129,.16); } }
        @keyframes troph-modal-in { from { opacity: 0; transform: translateY(24px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
        .troph-fade-up { animation: troph-fade-up .5s cubic-bezier(.22,1,.36,1) both; }
        .troph-new-glow { animation: troph-glow-pulse 1.8s ease-out 1; }
        .troph-modal-in { animation: troph-modal-in .22s cubic-bezier(.22,1,.36,1) both; }
        @media (prefers-reduced-motion: reduce) { .troph-fade-up, .troph-new-glow, .troph-modal-in { animation: none; } }
      `}</style>

      <div className="relative mx-auto max-w-5xl space-y-6 p-4 pb-32">
        <section className="troph-fade-up relative overflow-hidden rounded-[22px] border border-white/[0.08] shadow-[0_16px_50px_rgba(0,0,0,.3)]"
          style={{ backgroundImage: "linear-gradient(90deg, rgba(2,9,20,.93) 0%, rgba(2,9,20,.86) 55%, rgba(2,9,20,.95) 100%), url('/stadium-bg.jpg')", backgroundPosition: "center center", backgroundSize: "cover", backgroundRepeat: "no-repeat" }}>
          <div className="relative flex flex-col gap-3 px-6 py-7 md:px-9 md:py-9">
            <div className="flex items-center gap-2 font-mono text-[9px] font-bold uppercase tracking-[0.3em] text-amber-300"><Trophy size={12} /> Saison 2026-2027</div>
            <h1 className="bg-gradient-to-b from-white via-white to-amber-100 bg-clip-text font-display text-3xl font-black uppercase leading-none tracking-[-0.02em] text-transparent md:text-5xl" style={{ filter: "drop-shadow(0 1px 0 rgba(0,0,0,.35)) drop-shadow(0 0 18px rgba(251,191,36,.16))" }}>Votre palmares</h1>
            <p className="max-w-md text-sm text-slate-400">Trophees &amp; succes - Saison 2026-2027</p>
            <div className="mt-2 grid max-w-sm grid-cols-3 gap-3">
              <HeroStat label="Trophees" value={unlockedCount} />
              <HeroStat label="En cours" value={inProgressCount} />
              <HeroStat label="Progression" value={`${progressionPct}%`} />
            </div>
          </div>
        </section>

        {!connected && <section className="troph-fade-up rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 text-sm text-slate-300 backdrop-blur-md">Connecte-toi pour consulter ton palmares personnel.</section>}
        {errorMessage && <section className="troph-fade-up rounded-2xl border border-red-400/20 bg-red-500/[0.06] px-5 py-3 text-xs text-red-200">{errorMessage}</section>}

        {loading ? <div className="troph-fade-up py-16 text-center font-mono text-sm text-slate-500">Chargement de ton palmares...</div> : connected && (
          <>
            <section className="troph-fade-up relative overflow-hidden rounded-[26px] border border-white/[0.08] bg-white/[0.02] p-6 text-center shadow-[0_20px_60px_rgba(0,0,0,.3)] backdrop-blur-md md:p-10">
              <div className="font-mono text-[10px] font-semibold uppercase tracking-[.3em] text-slate-500">Saison 2026-2027</div>
              <div className="relative mx-auto mt-6 flex h-36 w-36 items-center justify-center sm:h-40 sm:w-40 md:h-44 md:w-44">
                <div className={`absolute inset-0 rounded-full blur-2xl transition-opacity duration-700 ${unlockedCount > 0 ? "bg-amber-300/25 opacity-100" : "bg-emerald-400/10 opacity-50"}`} />
                <div className="relative h-full w-full rounded-full p-[6px]" style={{ background: `conic-gradient(${unlockedCount > 0 ? "#fbbf24" : "#334155"} 0deg ${progressionPct * 3.6}deg, rgba(255,255,255,.07) ${progressionPct * 3.6}deg 360deg)` }}>
                  <div className="flex h-full w-full flex-col items-center justify-center rounded-full border border-white/10 bg-[#060b16]">
                    <Trophy size={40} strokeWidth={1.6} className={unlockedCount > 0 ? "text-amber-300" : "text-slate-700"} />
                  </div>
                </div>
              </div>
              <div className="mt-6 font-display text-3xl font-black text-white md:text-4xl">{unlockedCount} / {totalCount}</div>
              <div className="font-mono text-[10px] font-semibold uppercase tracking-widest text-slate-500">Trophees debloques</div>
              <div className="mx-auto mt-5 max-w-xs"><ProgressBar ratio={progressionPct / 100} state={unlockedCount > 0 ? "unlocked" : "locked"} /><div className="mt-1.5 text-right font-mono text-[11px] font-bold text-emerald-300">{progressionPct}%</div></div>
            </section>

            {nextObjective ? (
              <section className="troph-fade-up rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5 backdrop-blur-md md:p-7">
                <div className="flex items-center gap-2 text-emerald-300"><Target size={16} /><span className="font-mono text-[10px] font-semibold uppercase tracking-[.2em]">Prochain objectif</span></div>
                <div className="mt-4 flex items-start gap-4">
                  <TrophyMedal view={nextObjective} size={52} />
                  <div className="min-w-0 flex-1">
                    <div className="font-display text-lg font-bold text-white">{nextObjective.name}</div>
                    <div className="font-mono text-[9px] font-semibold uppercase tracking-widest text-slate-500">{nextObjective.category}</div>
                    <p className="mt-1 text-sm text-slate-400">{nextObjective.desc}</p>
                    <div className="mt-3 flex items-center justify-between text-xs font-bold text-white"><span>{nextObjective.progressRaw} / {nextObjective.goal}</span></div>
                    <div className="mt-1.5"><ProgressBar ratio={nextObjective.ratio} state={nextObjective.state} /></div>
                    <p className="mt-2 text-xs text-emerald-300">Encore {Math.max(nextObjective.goal - nextObjective.progressRaw, 0)} pour debloquer ce trophee</p>
                  </div>
                </div>
              </section>
            ) : (
              <section className="troph-fade-up rounded-2xl border border-amber-300/20 bg-amber-300/[0.05] p-6 text-center backdrop-blur-md">
                <Sparkles className="mx-auto text-amber-300" size={22} />
                <div className="mt-2 font-display text-lg font-bold uppercase text-white">Palmares complet</div>
                <p className="mt-1 text-sm text-slate-400">Tous les trophees disponibles sont debloques.</p>
              </section>
            )}

            <section className="troph-fade-up">
              <div className="rounded-2xl border border-white/[0.07] bg-white/[0.045] px-4 py-3 backdrop-blur-md">
                <h2 className="font-display text-xl font-bold uppercase tracking-tight text-white">Mes trophees</h2>
                <p className="text-xs text-slate-400">Progresse au fil des journees et construis ton palmares.</p>
              </div>
              <div className="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
                {views.map((view, index) => (
                  <TrophyCard key={view.id} view={view} index={index} isNew={newlyUnlockedIds.has(view.id)} onOpen={() => setSelectedId(view.id)} />
                ))}
              </div>
            </section>
          </>
        )}
      </div>

      {selectedView && <TrophyModal view={selectedView} onClose={() => setSelectedId(null)} />}
    </AppShell>
  );
}
