import PushNotificationsButton from "@/components/PushNotificationsButton";
import { useEffect, useState } from "react";
import { Link } from "@tanstack/react-router";
import { MessageCircle, X, Users, ChevronRight, Send, Smile, Image as ImageIcon, Search, Film } from "lucide-react";
import { supabase } from "@/lib/supabase";

type Profile = {
  id: string;
  pseudo?: string | null;
  avatar_url?: string | null;
};

type ChatMessage = {
  id: string;
  user_id: string | null;
  content: string;
  created_at: string;
  profile?: Profile | null;
};

type GiphyGif = {
  id: string;
  title?: string;
  images?: {
    fixed_width?: { url?: string; width?: string; height?: string };
    fixed_width_small?: { url?: string; width?: string; height?: string };
    original?: { url?: string; width?: string; height?: string };
  };
};

type VestiaireFloatingButtonProps = {
  href?: string;
  currentPath?: string;
};

// GIF : définir VITE_GIPHY_API_KEY dans .env.local.
// GIPHY propose les endpoints Trending et Search pour une vraie recherche de GIFs.
// Voir la documentation officielle : https://developers.giphy.com/docs/api/endpoint/

function displayName(profile?: Profile | null) {
  return profile?.pseudo?.trim() || "Joueur";
}

function initials(profile?: Profile | null) {
  const name = displayName(profile);
  return name
    .split(/\s+/)
    .map((part) => part[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
}

function preview(content: string) {
  if (!content) return "Message";
  if (content.startsWith("media:")) return "📷 Photo";
  return content.replace(/\s+/g, " ").trim().slice(0, 72);
}

/**
 * Onglet flottant global du Vestiaire.
 *
 * Bouton flottant global du Vestiaire. La route actuelle du Vestiaire est /trophees.
 * Le bouton disparaît automatiquement sur la page du Vestiaire.
 */
export function VestiaireFloatingButton({
  href = "/trophees",
  currentPath,
}: VestiaireFloatingButtonProps) {
  const [open, setOpen] = useState(false);
  const [messages, setMessages] = useState<ChatMessage[]>([]);
  const [onlineCount, setOnlineCount] = useState(0);
  const [draft, setDraft] = useState("");
  const [showEmojiPicker, setShowEmojiPicker] = useState(false);
  const [sending, setSending] = useState(false);
  const [selectedImage, setSelectedImage] = useState<File | null>(null);
  const [imagePreview, setImagePreview] = useState<string | null>(null);
  const [authUserId, setAuthUserId] = useState<string | null>(null);
  const [sendError, setSendError] = useState<string | null>(null);
  const [showGifPicker, setShowGifPicker] = useState(false);
  const [gifQuery, setGifQuery] = useState("");
  const [gifResults, setGifResults] = useState<GiphyGif[]>([]);
  const [gifLoading, setGifLoading] = useState(false);
  const [gifError, setGifError] = useState<string | null>(null);
  const [pendingGif, setPendingGif] = useState<{ url: string; preview?: string; title?: string; provider?: string; id?: string } | null>(null);
  const [unreadCount, setUnreadCount] = useState(0);

  const isVestiairePage =
    currentPath === href ||
    (typeof window !== "undefined" && window.location.pathname === href);

  useEffect(() => {
    if (isVestiairePage) return;

    let mounted = true;

    async function loadAuthenticatedUser() {
      const { data, error } = await supabase.auth.getUser();

      if (!mounted) return;

      if (error) {
        console.error("Impossible de récupérer l'utilisateur connecté :", error);
        setAuthUserId(null);
        return;
      }

      const userId = data.user?.id ?? null;
      setAuthUserId(userId);
      await refreshUnreadCount(userId);
    }

    async function loadPreview() {
      const { data: rows } = await supabase
        .from("chat_messages")
        .select("id,user_id,content,created_at")
        .order("created_at", { ascending: false })
        .limit(4);

      if (!mounted || !rows?.length) return;

      const userIds = [...new Set(rows.map((row) => row.user_id).filter(Boolean))] as string[];

      let profiles: Profile[] = [];
      if (userIds.length) {
        const { data } = await supabase
          .from("profiles")
          .select("id,pseudo,avatar_url")
          .in("id", userIds);

        profiles = data ?? [];
      }

      const profileMap = new Map(profiles.map((profile) => [profile.id, profile]));

      setMessages(
        rows.map((row) => ({
          ...row,
          profile: row.user_id ? profileMap.get(row.user_id) ?? null : null,
        })),
      );
    }

    async function loadOnlineCount() {
      // La présence détaillée reste gérée par la page Vestiaire.
      // Ici on affiche uniquement le nombre de messages récents comme fallback visuel.
      const { count } = await supabase
        .from("profiles")
        .select("id", { count: "exact", head: true });

      if (mounted) setOnlineCount(count ?? 0);
    }

    void loadAuthenticatedUser();
    void loadPreview();
    void loadOnlineCount();

    const channel = supabase
      .channel("vestiaire-floating-preview")
      .on(
        "postgres_changes",
        {
          event: "INSERT",
          schema: "public",
          table: "chat_messages",
        },
        (payload) => {
          void loadPreview();

          const newMessage = payload.new as ChatMessage;
          if (newMessage?.user_id && newMessage.user_id !== authUserId) {
            void refreshUnreadCount(authUserId);
          }
        },
      )
      .subscribe();

    const handleUnreadStorage = (event: StorageEvent) => {
      if (event.key === UNREAD_STORAGE_KEY) {
        void refreshUnreadCount(authUserId);
      }
    };

    window.addEventListener("storage", handleUnreadStorage);

    return () => {
      mounted = false;
      window.removeEventListener("storage", handleUnreadStorage);
      void supabase.removeChannel(channel);
    };
  }, [isVestiairePage]);


  const UNREAD_STORAGE_KEY = "prono-ligue1-vestiaire-last-read";

  async function refreshUnreadCount(userId: string | null) {
    if (!userId) {
      setUnreadCount(0);
      return;
    }

    const lastRead = window.localStorage.getItem(UNREAD_STORAGE_KEY);
    if (!lastRead) {
      setUnreadCount(0);
      return;
    }

    const { count, error } = await supabase
      .from("chat_messages")
      .select("id", { count: "exact", head: true })
      .gt("created_at", lastRead)
      .neq("user_id", userId);

    if (!error) setUnreadCount(count ?? 0);
  }

  function markVestiaireAsRead() {
    const now = new Date().toISOString();
    window.localStorage.setItem(UNREAD_STORAGE_KEY, now);
    setUnreadCount(0);
    window.dispatchEvent(new StorageEvent("storage", {
      key: UNREAD_STORAGE_KEY,
      newValue: now,
    }));
  }

  const commonEmojis = ["😀", "😂", "🔥", "⚽", "👏", "❤️", "💚", "💜", "🎯", "🏆", "🤣", "👀"];

  async function searchGifs(query = gifQuery) {
    const apiKey = import.meta.env.VITE_GIPHY_API_KEY as string | undefined;

    if (!apiKey) {
      setGifError("Ajoute VITE_GIPHY_API_KEY dans ton .env pour activer les GIF.");
      setGifResults([]);
      return;
    }

    setGifLoading(true);
    setGifError(null);

    try {
      const trimmed = query.trim();
      const endpoint = trimmed
        ? "https://api.giphy.com/v1/gifs/search"
        : "https://api.giphy.com/v1/gifs/trending";

      const params = new URLSearchParams({
        api_key: apiKey,
        limit: "18",
        rating: "pg-13",
        lang: "fr",
      });

      if (trimmed) params.set("q", trimmed);

      const response = await fetch(`${endpoint}?${params.toString()}`);

      if (!response.ok) {
        throw new Error(`GIPHY ${response.status}`);
      }

      const json = await response.json();
      setGifResults(Array.isArray(json.data) ? json.data : []);
    } catch (error) {
      console.error("Erreur GIPHY :", error);
      setGifResults([]);
      setGifError("Impossible de charger les GIF pour le moment.");
    } finally {
      setGifLoading(false);
    }
  }

  function openGifPicker() {
    const next = !showGifPicker;
    setShowGifPicker(next);
    setShowEmojiPicker(false);

    if (next && gifResults.length === 0) {
      void searchGifs("");
    }
  }

  function selectGifForSending(gif: GiphyGif) {
    const gifUrl =
      gif.images?.original?.url ??
      gif.images?.fixed_width?.url ??
      gif.images?.fixed_width_small?.url;

    if (!gifUrl) return;

    setPendingGif({
      url: gifUrl,
      preview: gif.images?.fixed_width?.url ?? gif.images?.fixed_width_small?.url ?? gifUrl,
      title: gif.title ?? "GIF",
      provider: "giphy",
      id: gif.id,
    });
    setShowGifPicker(false);
    setShowEmojiPicker(false);
    setGifError(null);
  }

  function renderMessageContent(content: string) {
    let payload: {
      v?: number;
      text?: string;
      images?: string[];
      gif?: {
        url?: string;
        preview?: string;
        title?: string;
        provider?: string;
        id?: string;
      };
    } | null = null;

    // Nouveau format commun du Vestiaire : {"v":1,...,"gif":{...}}
    if (content.trim().startsWith("{")) {
      try {
        const parsed = JSON.parse(content);
        if (parsed && typeof parsed === "object" && parsed.gif) {
          payload = parsed;
        }
      } catch {
        // Texte normal : on continue.
      }
    }

    // Compatibilité avec les anciens GIF envoyés depuis le floating.
    if (!payload && content.startsWith("__GIF__")) {
      try {
        const legacy = JSON.parse(content.slice("__GIF__".length));
        if (legacy && typeof legacy.url === "string") {
          payload = {
            v: 1,
            text: "",
            images: [],
            gif: {
              url: legacy.url,
              preview: legacy.preview,
              title: legacy.title,
              provider: legacy.provider || "giphy",
              id: legacy.id,
            },
          };
        }
      } catch {
        return "🎞️ GIF";
      }
    }

    if (payload?.gif?.url) {
      const gif = payload.gif;

      return (
        <div className="mt-1 w-fit max-w-[260px] overflow-hidden rounded-xl border border-purple-400/15 bg-black/20">
          <img
            src={gif.preview || gif.url}
            alt={gif.title || "GIF"}
            className="block max-h-[160px] w-auto max-w-[260px] rounded-xl object-contain"
            loading="lazy"
          />
          <div className="px-2 py-1 text-[8px] font-bold uppercase tracking-wider text-slate-600">
            GIF • GIPHY
          </div>
        </div>
      );
    }

    if (payload?.text) {
      return preview(payload.text);
    }

    return preview(content);
  }

  function addEmoji(emoji: string) {
    setDraft((value) => `${value}${emoji}`);
    setShowEmojiPicker(false);
    setShowGifPicker(false);
  }

  function handleImageSelect(file?: File | null) {
    if (!file || !file.type.startsWith("image/")) return;

    if (imagePreview) URL.revokeObjectURL(imagePreview);

    setSelectedImage(file);
    setImagePreview(URL.createObjectURL(file));
  }

  function clearSelectedImage() {
    if (imagePreview) URL.revokeObjectURL(imagePreview);
    setSelectedImage(null);
    setImagePreview(null);
  }

  async function sendMiniMessage() {
    const content = draft.trim();

    if (!content && !selectedImage && !pendingGif) return;
    if (sending) return;

    setSending(true);
    setSendError(null);

    try {
      let userId = authUserId;

      // On récupère toujours l'utilisateur courant juste avant l'envoi.
      // Cela évite les erreurs lorsque le composant a été monté avant
      // que la session Supabase soit complètement disponible.
      if (!userId) {
        const { data, error: authError } = await supabase.auth.getUser();

        if (authError) {
          throw new Error(`Session Supabase inaccessible : ${authError.message}`);
        }

        userId = data.user?.id ?? null;
        setAuthUserId(userId);
      }

      if (!userId) {
        throw new Error("Aucun compte connecté. Reconnecte-toi pour envoyer un message.");
      }

      /*
       * Le champ user_id est envoyé explicitement.
       * C'est important si chat_messages utilise user_id NOT NULL
       * ou une policy RLS basée sur auth.uid().
       */
      let finalContent = content;

      if (pendingGif) {
        finalContent = JSON.stringify({
          v: 1,
          text: content,
          images: [],
          gif: {
            url: pendingGif.url,
            preview: pendingGif.preview ?? pendingGif.url,
            title: pendingGif.title ?? "GIF",
            provider: pendingGif.provider ?? "giphy",
            id: pendingGif.id,
          },
        });
      } else if (selectedImage) {
        finalContent = `${content ? `${content} ` : ""}📷 ${selectedImage.name}`;
      }

      const { data, error } = await supabase
        .from("chat_messages")
        .insert({
          user_id: userId,
          content: finalContent,
        })
        .select("id,user_id,content,created_at")
        .single();

      if (error) {
        throw new Error(`Supabase : ${error.message}`);
      }

      if (data) {
        // Recharge le profil pour que le message apparaisse immédiatement
        // avec le pseudo/avatar du compte connecté.
        const { data: profile } = await supabase
          .from("profiles")
          .select("id,pseudo,avatar_url")
          .eq("id", userId)
          .maybeSingle();

        setMessages((current) => [
          {
            ...data,
            profile: profile ?? null,
          },
          ...current.filter((message) => message.id !== data.id),
        ]);
      }

      setDraft("");
      clearSelectedImage();
      setPendingGif(null);
      setShowEmojiPicker(false);
      setSendError(null);
    } catch (error) {
      console.error("Erreur envoi mini-chat Vestiaire :", error);
      setSendError(
        error instanceof Error
          ? error.message
          : "Impossible d'envoyer le message.",
      );
    } finally {
      setSending(false);
    }
  }

  function handleComposerKeyDown(event: React.KeyboardEvent<HTMLInputElement>) {
    if (event.key === "Enter") {
      event.preventDefault();
      void sendMiniMessage();
    }
  }

  if (isVestiairePage) return null;

  return (
    <>
      {/* Mini Vestiaire interactif */}
      {open && (
        <div
          className="
            fixed bottom-24 right-5 z-[100]
            w-[380px] max-w-[calc(100vw-24px)]
            overflow-hidden rounded-3xl
            border border-purple-400/25
            bg-[#06101c]/96
            shadow-[0_25px_80px_rgba(0,0,0,.60),0_0_45px_rgba(168,85,247,.16)]
            backdrop-blur-2xl
          "
        >
          <div className="flex items-center justify-between border-b border-white/[.07] bg-gradient-to-r from-purple-500/15 via-transparent to-emerald-400/10 px-4 py-3">
            <div className="flex items-center gap-3">
              <div className="grid size-10 place-items-center rounded-xl bg-gradient-to-br from-purple-500 to-emerald-400 text-white shadow-[0_0_25px_rgba(16,185,129,.18)]">
                <MessageCircle size={19} />
              </div>

              <div>
                <div className="font-display text-sm font-black uppercase text-white">
                  Le Vestiaire
                </div>
                <div className="flex items-center gap-1.5 text-[10px] text-emerald-300">
                  <span className="size-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(16,185,129,.9)]" />
                  Chat en direct
                </div>
              </div>
            </div>

            <div className="flex items-center gap-1">
              <Link
                to={href as never}
                onClick={() => setOpen(false)}
                className="rounded-lg px-2 py-1.5 text-[9px] font-bold uppercase tracking-wider text-slate-400 transition hover:bg-white/5 hover:text-white"
              >
                Ouvrir
              </Link>

              <button
                type="button"
                onClick={() => setOpen(false)}
                className="grid size-8 place-items-center rounded-xl border border-white/10 text-slate-500 transition hover:bg-white/5 hover:text-white"
                aria-label="Fermer"
              >
                <X size={15} />
              </button>
            </div>
          </div>

          {/* Messages */}
          <div className="max-h-[300px] min-h-[180px] space-y-2 overflow-y-auto p-3">
            <div className="border-b border-white/[.07] px-3 py-3">
              <PushNotificationsButton />
            </div>
            {messages.length ? (
              messages.slice(0, 6).map((message) => (
                <div
                  key={message.id}
                  className="flex gap-2.5 rounded-2xl border border-white/[.06] bg-white/[.025] p-2.5"
                >
                  <div className="grid size-8 shrink-0 place-items-center overflow-hidden rounded-full border border-emerald-400/25 bg-gradient-to-br from-purple-500/30 to-emerald-400/20 text-[9px] font-black text-white">
                    {message.profile?.avatar_url ? (
                      <img
                        src={message.profile.avatar_url}
                        alt=""
                        className="size-full object-cover"
                      />
                    ) : (
                      initials(message.profile)
                    )}
                  </div>

                  <div className="min-w-0 flex-1">
                    <div className="flex items-center justify-between gap-2">
                      <span className="truncate text-[10px] font-bold text-emerald-300">
                        {displayName(message.profile)}
                      </span>
                      <span className="shrink-0 text-[8px] text-slate-600">
                        {new Date(message.created_at).toLocaleTimeString("fr-FR", {
                          hour: "2-digit",
                          minute: "2-digit",
                        })}
                      </span>
                    </div>

                    <div className="mt-0.5 break-words text-[11px] leading-relaxed text-slate-300">
                      {renderMessageContent(message.content)}
                    </div>
                  </div>
                </div>
              ))
            ) : (
              <div className="flex min-h-[160px] flex-col items-center justify-center rounded-2xl border border-white/[.06] bg-white/[.02] p-5 text-center">
                <div className="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-purple-500/15 to-emerald-400/10 text-slate-500">
                  <MessageCircle size={22} />
                </div>
                <p className="mt-3 text-xs font-semibold text-slate-400">
                  Le Vestiaire est calme...
                </p>
                <p className="mt-1 text-[10px] text-slate-600">
                  Lance la discussion depuis cette fenêtre.
                </p>
              </div>
            )}
          </div>

          {/* GIF picker GIPHY */}
          {showGifPicker && (
            <div className="mx-3 mb-2 overflow-hidden rounded-2xl border border-purple-400/20 bg-[#0a1524] shadow-xl">
              <div className="flex items-center gap-2 border-b border-white/[.06] p-2">
                <div className="grid size-8 shrink-0 place-items-center rounded-lg bg-purple-500/10 text-purple-300">
                  <Film size={15} />
                </div>

                <div className="relative flex-1">
                  <Search
                    size={13}
                    className="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-600"
                  />
                  <input
                    value={gifQuery}
                    onChange={(event) => setGifQuery(event.target.value)}
                    onKeyDown={(event) => {
                      if (event.key === "Enter") {
                        event.preventDefault();
                        void searchGifs();
                      }
                    }}
                    placeholder="Rechercher un GIF..."
                    className="h-8 w-full rounded-lg border border-white/[.07] bg-white/[.025] pl-8 pr-2 text-[10px] text-white outline-none placeholder:text-slate-600 focus:border-purple-400/30"
                  />
                </div>

                <button
                  type="button"
                  onClick={() => void searchGifs()}
                  className="h-8 rounded-lg bg-purple-500/15 px-2.5 text-[9px] font-black uppercase text-purple-300 transition hover:bg-purple-500/25"
                >
                  OK
                </button>
              </div>

              {gifError ? (
                <div className="p-3 text-[9px] leading-relaxed text-amber-300">
                  {gifError}
                </div>
              ) : gifLoading ? (
                <div className="grid h-32 place-items-center text-[10px] text-slate-500">
                  Recherche des GIF...
                </div>
              ) : (
                <div className="grid max-h-48 grid-cols-3 gap-1.5 overflow-y-auto p-2">
                  {gifResults.map((gif) => {
                    const url =
                      gif.images?.fixed_width_small?.url ??
                      gif.images?.fixed_width?.url ??
                      gif.images?.original?.url;

                    if (!url) return null;

                    return (
                      <button
                        key={gif.id}
                        type="button"
                        disabled={sending}
                        onClick={() => selectGifForSending(gif)}
                        className="group relative aspect-square overflow-hidden rounded-lg bg-black/20 disabled:opacity-40"
                        title={gif.title || "Sélectionner ce GIF"}
                      >
                        <img
                          src={url}
                          alt={gif.title || "GIF"}
                          className="size-full object-cover transition duration-200 group-hover:scale-105"
                          loading="lazy"
                        />
                        <span className="absolute inset-x-0 bottom-0 bg-black/60 px-1 py-1 text-[7px] font-bold text-white opacity-0 transition group-hover:opacity-100">
                          ENVOYER
                        </span>
                      </button>
                    );
                  })}
                </div>
              )}

              <div className="border-t border-white/[.06] px-2 py-1.5 text-[7px] font-semibold uppercase tracking-wider text-slate-600">
                Powered by GIPHY
              </div>
            </div>
          )}

          {pendingGif && (
            <div className="mx-3 mb-2 flex items-center gap-2 rounded-xl border border-purple-400/20 bg-purple-500/[.06] p-2">
              <img
                src={pendingGif.preview || pendingGif.url}
                alt={pendingGif.title || "GIF sélectionné"}
                className="h-12 w-16 rounded-lg object-cover"
              />
              <div className="min-w-0 flex-1">
                <p className="text-[10px] font-semibold text-purple-200">GIF sélectionné</p>
                <p className="truncate text-[9px] text-slate-500">{pendingGif.title || "GIF GIPHY"}</p>
              </div>
              <button
                type="button"
                onClick={() => setPendingGif(null)}
                className="grid size-7 place-items-center rounded-lg text-slate-500 hover:bg-white/5 hover:text-white"
                aria-label="Retirer le GIF"
              >
                <X size={13} />
              </button>
            </div>
          )}

          {/* Aperçu image */}
          {imagePreview && (
            <div className="mx-3 mb-2 flex items-center gap-2 rounded-xl border border-purple-400/20 bg-purple-500/[.06] p-2">
              <img
                src={imagePreview}
                alt="Aperçu"
                className="size-12 rounded-lg object-cover"
              />
              <div className="min-w-0 flex-1">
                <p className="truncate text-[10px] font-semibold text-white">
                  {selectedImage?.name}
                </p>
                <p className="text-[9px] text-emerald-300">Image prête à envoyer</p>
              </div>
              <button
                type="button"
                onClick={clearSelectedImage}
                className="grid size-7 place-items-center rounded-lg text-slate-500 hover:bg-white/5 hover:text-white"
                aria-label="Retirer la photo"
              >
                <X size={13} />
              </button>
            </div>
          )}

          {/* Emoji picker */}
          {showEmojiPicker && (
            <div className="mx-3 mb-2 grid grid-cols-6 gap-1 rounded-2xl border border-purple-400/20 bg-[#0a1524] p-2 shadow-xl">
              {commonEmojis.map((emoji) => (
                <button
                  key={emoji}
                  type="button"
                  onClick={() => addEmoji(emoji)}
                  className="grid size-9 place-items-center rounded-xl text-lg transition hover:bg-white/[.06] hover:scale-110"
                >
                  {emoji}
                </button>
              ))}
            </div>
          )}

          {/* Composer */}
          <div className="border-t border-white/[.07] bg-black/15 p-3">
            <div className="flex items-center gap-2 rounded-2xl border border-white/10 bg-white/[.035] p-2 transition focus-within:border-emerald-400/30">
              <button
                type="button"
                onClick={() => setShowEmojiPicker((value) => !value)}
                className={`grid size-9 shrink-0 place-items-center rounded-xl transition ${
                  showEmojiPicker
                    ? "bg-purple-500/20 text-purple-300"
                    : "text-slate-500 hover:bg-white/5 hover:text-emerald-300"
                }`}
                aria-label="Ajouter un emoji"
              >
                <Smile size={18} />
              </button>

              <label
                className="grid size-9 shrink-0 cursor-pointer place-items-center rounded-xl text-slate-500 transition hover:bg-white/5 hover:text-emerald-300"
                aria-label="Ajouter une photo"
              >
                <ImageIcon size={18} />
                <input
                  type="file"
                  accept="image/*"
                  className="hidden"
                  onChange={(event) => {
                    handleImageSelect(event.target.files?.[0]);
                    event.currentTarget.value = "";
                  }}
                />
              </label>

              <button
                type="button"
                onClick={openGifPicker}
                className={`grid size-9 shrink-0 place-items-center rounded-xl text-[10px] font-black transition ${
                  showGifPicker
                    ? "bg-purple-500/20 text-purple-300"
                    : "text-slate-500 hover:bg-white/5 hover:text-purple-300"
                }`}
                aria-label="Choisir un GIF"
                title="GIF"
              >
                GIF
              </button>

              <input
                value={draft}
                onChange={(event) => setDraft(event.target.value)}
                onKeyDown={handleComposerKeyDown}
                placeholder="Écris ton message..."
                maxLength={1000}
                className="min-w-0 flex-1 bg-transparent px-1 text-xs text-white outline-none placeholder:text-slate-600"
              />

              <button
                type="button"
                disabled={sending || (!draft.trim() && !selectedImage && !pendingGif)}
                onClick={() => void sendMiniMessage()}
                className="grid size-9 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-500 text-slate-950 shadow-[0_0_18px_rgba(16,185,129,.20)] transition hover:scale-105 disabled:cursor-not-allowed disabled:opacity-30"
                aria-label="Envoyer"
              >
                <Send size={16} />
              </button>
            </div>

            {sendError && (
              <div className="mt-2 rounded-xl border border-red-400/20 bg-red-500/[.06] px-3 py-2 text-[9px] font-semibold leading-relaxed text-red-300">
                {sendError}
              </div>
            )}

            <div className="mt-2 flex items-center justify-between px-1">
              <div className="flex items-center gap-1.5 text-[8px] font-bold uppercase tracking-wider text-slate-600">
                <Users size={11} />
                {onlineCount > 0 ? `${onlineCount} membres` : "Communauté"}
              </div>

              <Link
                to={href as never}
                onClick={() => setOpen(false)}
                className="text-[9px] font-bold text-emerald-300 transition hover:text-white"
              >
                Voir le chat complet →
              </Link>
            </div>
          </div>
        </div>
      )}

      {/* Onglet flottant */}
      <button
        type="button"
        onClick={() => { setOpen((value) => !value); markVestiaireAsRead(); }}
        aria-label="Ouvrir Le Vestiaire"
        aria-expanded={open}
        className="
          group fixed bottom-5 right-5 z-[101]
          flex items-center gap-3
          rounded-[22px]
          border border-purple-400/35
          bg-gradient-to-r from-[#4c1d95]/95 via-[#312e81]/95 to-[#059669]/95
          px-3 py-2.5
          shadow-[0_18px_55px_rgba(0,0,0,.45),0_0_30px_rgba(168,85,247,.20),0_0_40px_rgba(16,185,129,.12)]
          backdrop-blur-xl
          transition-all duration-300
          hover:-translate-y-1
          hover:scale-[1.02]
          hover:border-emerald-300/60
        "
      >
        <span className="relative grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-purple-400 via-violet-300 to-emerald-300 text-white shadow-[0_0_25px_rgba(168,85,247,.30)]">
          <MessageCircle size={23} strokeWidth={2.4} />

          <span className="absolute -right-1 -top-1 grid size-4 place-items-center rounded-full border-2 border-[#07101b] bg-emerald-400">
            <span className="size-1.5 rounded-full bg-white" />
          </span>
        </span>

        <span className="relative pr-1 text-left">
          <span className="block font-display text-sm font-black uppercase tracking-tight text-white">
            Le Vestiaire
            {unreadCount > 0 && (
              <span className="absolute -right-7 -top-2 grid min-w-5 h-5 place-items-center rounded-full border border-emerald-200/30 bg-emerald-400 px-1.5 text-[9px] font-black text-[#06101c] shadow-[0_0_16px_rgba(16,230,160,.60)]">
                {unreadCount > 9 ? "9+" : unreadCount}
              </span>
            )}
          </span>
          <span className="mt-0.5 block text-[9px] font-semibold text-white/60">
            Le chat privé du groupe
          </span>
        </span>
      </button>
    </>
  );
}

export default VestiaireFloatingButton;